{
  "name": "panorama-360-se-dsh-pet",
  "version": "1.1.1",
  "description": "PANORAMA-360-SE-DSH-PET：展域屏摇尾桌宠、余额与断线重连",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./dsh-dafeiyu-screen/index.js",
    "./client": "./dsh-dafeiyu-screen/client.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json",
    "dsh-dafeiyu-screen/package.json",
    "dsh-dafeiyu-screen/*.js",
    "dsh-dafeiyu-screen/*.html",
    "dsh-dafeiyu-screen/*.md",
    "dsh-dafeiyu-screen/LICENSE",
    "dsh-dafeiyu-screen/cordis.patch.yml",
    "dsh-dafeiyu-screen/assets",
    "dsh-dafeiyu-screen/worker/*.py",
    "dsh-dafeiyu-screen/worker/LICENSE",
    "dsh-dafeiyu-screen/scripts",
    "dsh-dafeiyu-screen/dependencies.json",
    "dsh-dafeiyu-screen/*.cmd",
    "dsh-dafeiyu-screen/npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node dsh-dafeiyu-screen/standalone.js",
    "test": "node --test dsh-dafeiyu-screen/tests/*.test.js"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh-dafeiyu-screen/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andromedahk/kanali-open-screen.git"
  },
  "keywords": [
    "dsh-plugin",
    "panorama-360-se",
    "desktop-pet"
  ]
}
