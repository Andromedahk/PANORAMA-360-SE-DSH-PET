{
  "name": "panorama-360-se-dsh-pet",
  "version": "1.1.5",
  "description": "PANORAMA-360-SE-DSH-PET：展域屏摇尾桌宠、余额与断线重连",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "*.js",
    "*.html",
    "*.md",
    "LICENSE",
    "cordis.patch.yml",
    "assets",
    "worker/*.py",
    "worker/LICENSE",
    "scripts",
    "dependencies.json",
    "package-lock.json",
    "*.cmd",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "start": "node standalone.js",
    "test": "node --test tests/*.test.js",
    "bootstrap": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dependencies.ps1"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andromedahk/PANORAMA-360-SE-DSH-PET.git"
  },
  "keywords": [
    "dsh-plugin",
    "panorama-360-se",
    "desktop-pet"
  ]
}
